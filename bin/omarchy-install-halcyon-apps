#!/bin/bash

# omarchy:summary=Install the Halcyon apps (games, mail, photos, media and more) for this user
# omarchy:requires-sudo=true

set -euo pipefail

source_dir="$OMARCHY_PATH/halcyon"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
install_dir="$data_home/omarchy-halcyon"
bin_dir="$HOME/.local/bin"
applications_dir="$data_home/applications"

ruffle_version=0.7.1
ruffle_sha256=dc9e7407549a91accc41a14932b0b9d9a9d51a3742ce6f020888c8a76682b157
otvdm_version=0.9.0
otvdm_sha256=842b11aed5fa81f3e1d4272e0ee7d37f1a5a8f936de825309dda672835e16fd4

# Flash support for Halcyon Navigator. The browser still works without it.
install_ruffle() {
  local tmp
  tmp=$(mktemp -d)

  if curl -fsSL -o "$tmp/ruffle.tgz" "https://registry.npmjs.org/@ruffle-rs/ruffle/-/ruffle-$ruffle_version.tgz" &&
    echo "$ruffle_sha256  $tmp/ruffle.tgz" | sha256sum --check --status; then
    mkdir -p "$install_dir/apps/retro/ruffle"
    tar -xzf "$tmp/ruffle.tgz" -C "$install_dir/apps/retro/ruffle" --strip-components=1 --wildcards \
      package/ruffle.js 'package/core.ruffle.*.js' 'package/*.wasm' package/LICENSE_MIT package/LICENSE_APACHE
  else
    echo "Could not download Ruffle, so Halcyon Navigator will run without Flash." >&2
  fi

  rm -rf -- "$tmp"
}

# 16-bit Windows setup programs on old discs. Newer discs work without it.
install_otvdm() {
  local tmp
  tmp=$(mktemp -d)

  if curl -fsSL -o "$tmp/otvdm.zip" "https://github.com/otya128/winevdm/releases/download/v$otvdm_version/otvdm-v$otvdm_version.zip" &&
    echo "$otvdm_sha256  $tmp/otvdm.zip" | sha256sum --check --status; then
    mkdir -p "$install_dir/otvdm"
    bsdtar -xf "$tmp/otvdm.zip" -C "$install_dir/otvdm" --strip-components=1
  else
    echo "Could not download otvdm, so very old Windows discs may not install." >&2
  fi

  rm -rf -- "$tmp"
}

# The on-screen keyboard types through /dev/uinput, which the logged-in user needs access to.
install_uinput_access() {
  sudo install -Dm644 "$install_dir/udev/70-halcyon-uinput.rules" /etc/udev/rules.d/70-halcyon-uinput.rules
  sudo install -Dm644 "$install_dir/udev/halcyon-uinput.conf" /etc/modules-load.d/halcyon-uinput.conf
  sudo modprobe uinput
  sudo udevadm control --reload
  sudo udevadm trigger --name-match=uinput
}

# Reminders, sticky notes, disc watching and the on-screen keyboard start at login.
# They go in the user's own autostart file, which Omarchy leaves alone on update.
add_autostart() {
  local autostart="$HOME/.config/hypr/autostart.lua"

  local entry

  mkdir -p "$(dirname "$autostart")"
  for entry in "halcyon-calendar --daemon" "halcyon-notes --restore" "halcyon-autoplay-daemon" "halcyon-osk --daemon"; do
    if ! grep -qsF "$entry" "$autostart"; then
      echo "o.launch_on_start(os.getenv(\"HOME\") .. \"/.local/bin/$entry\")" >>"$autostart"
    fi
  done
}

mapfile -t packages <"$source_dir/packages.txt"
omarchy-pkg-add "${packages[@]}"

mkdir -p "$data_home" "$bin_dir" "$applications_dir"
rm -rf -- "$install_dir"
cp -r "$source_dir" "$install_dir"
install_ruffle
install_otvdm
install_uinput_access
add_autostart

for launcher in "$install_dir"/bin/halcyon-*; do
  ln -sfn "$launcher" "$bin_dir/$(basename "$launcher")"
done

cp "$install_dir"/applications/*.desktop "$applications_dir/"
install -Dm644 "$install_dir/assets/logo.png" "$data_home/icons/hicolor/512x512/apps/halcyon-logo.png"

if omarchy-cmd-present update-desktop-database; then
  update-desktop-database "$applications_dir" >/dev/null 2>&1 || true
fi

echo "Halcyon apps installed. Find them in the app launcher, or start with halcyon-welcome."
